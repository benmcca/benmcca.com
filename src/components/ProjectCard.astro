---
const { title, date, href, image, description } = Astro.props;
import { Image } from "astro:assets";
---

<article class="project-card">
  <a class="project-thumbnail-link" href={href} target="_blank" rel="noreferrer">
    <Image class="project-thumbnail" src={image} alt={`${title} project preview`} loading="lazy" />
  </a>
  <div class="project-content">
    <div class="project-header">
      <div class="project-title">
        <a href={href} target="_blank" rel="noreferrer">{title}</a>
      </div>
      <div class="project-dates">{date}</div>
    </div>
    <div class="project-description">{description}</div>
  </div>
</article>
